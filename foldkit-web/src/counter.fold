// The capped counter, as a Foldkit program.  fold/ turns this file into
// Rocq (CounterApp.v), Rocq proves the invariants below and prints the
// TypeScript module that counter.ts runs.

export const limit = 500;
const payloadMax = 999_999_999_999_999;

model {
  saved locked: boolean = false;
  amountOk: boolean = true;
  saved count: Nat<limit - 1> = 0;
  saved changes: Nat = 0;
  amount: Nat<payloadMax> = 250;
}

store "counter" {
  save: SaveCounter;
  done: CompletedSaveCounter;
  failed: FailedSaveCounter;
}

on ClickedAdd(n: Nat<payloadMax>) {
  if (!model.locked && model.count + n < limit) {
    next.count = model.count + n;
    next.changes = model.changes + 1;
    save();
  }
}

on ClickedSubtract(n: Nat<payloadMax>) {
  if (!model.locked && n <= model.count) {
    next.count = Math.max(0, model.count - n);
    next.changes = model.changes + 1;
    save();
  }
}

on ClickedReset() {
  if (!model.locked) {
    next.count = 0;
    next.changes = 0;
    save();
  }
}

on ClickedLock() {
  if (!model.locked) {
    next.locked = true;
    save();
  }
}

on ClickedUnlock() {
  if (model.locked) {
    next.locked = false;
    save();
  }
}

on ChangedAmount(n: Nat<payloadMax>) {
  next.amountOk = true;
  next.amount = n;
}

on ClearedAmount() {
  next.amountOk = false;
}

invariant belowCap: model.count < limit;
invariant amountFits: model.amount <= payloadMax;
