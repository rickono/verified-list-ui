{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  // TypeScript 7.1: src/*.fold are type-checked as the module Rocq prints
  // for them, and failed proofs are reported on the rule (fold/mapper).
  // Needs tsc --runExternalCode.
  "contentMappers": [{ "package": "fold-content-mapper", "extensions": [".fold"] }],
  "include": ["src", "vite.config.ts"]
}
