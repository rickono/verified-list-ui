{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "paths": {
      "@program": ["../_build/default/foldkit/counter.program.ts"],
      "@list-program": ["../_build/default/foldkit/list.program.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../_build/default/foldkit/counter.program.ts",
    "../_build/default/foldkit/list.program.ts"
  ]
}
