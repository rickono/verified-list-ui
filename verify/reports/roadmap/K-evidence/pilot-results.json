    "laterHistory": "6fe21d21e92d4f07b476d56fbcad838633e74550 (2024-04-13) rewrote the body to a destructuring swap, which the verifier grammar does not admit; this pin is the last temp-variable version."
  },
  "nativeSamples": 11,
  "contracts": [
    "modifies arr",
    "ensures result === arr",
    "ensures arr.every((v, k) => Object.is(v, old(arr.slice())[arr.length - 1 - k]))"
  ],
  "annotations": [
    "invariant Number.isInteger(i) && 0 <= i && i <= arr.length",
    "invariant Number.isInteger(j) && -1 <= j && j < arr.length && j === arr.length - 1 - i",
    "invariant arr.every((v, k) => k < i || k > j ? Object.is(v, old(arr.slice())[arr.length - 1 - k]) : Object.is(v, old(arr.slice())[k]))",
    "decreases real(arr.length) - real(i)"
  ],
  "mutants": [
    {
      "name": "lost-temp-mutant",
      "before": "arr[j] = temp",
      "after": "arr[j] = arr[i]"
    },
    {
      "name": "short-bound-mutant",
      "before": "i < arr.length / 2",
      "after": "i < arr.length / 2 - 1"
    },
    {
      "name": "over-swap-mutant",
      "before": "i < arr.length / 2",
      "after": "i <= arr.length / 2"
    }
  ],
