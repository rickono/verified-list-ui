      "licenseFetchedFrom": "https://raw.githubusercontent.com/TheAlgorithms/JavaScript/636017ca51dad05339cde3b5c66cbe1d71957f7e/LICENSE",
      "licenseSha256": "589ed823e9a84c56feb95ac58e7cf384626b9cbf4fda2a907bc36e103de1bad2",
      "laterHistory": "6fe21d21e92d4f07b476d56fbcad838633e74550 (2024-04-13) rewrote the body to a destructuring swap, which the verifier grammar does not admit; this pin is the last temp-variable version.",
      "reusedSource": "../K-evidence/pilot/Reverse.upstream.js",
      "reusedProvenance": "../K-evidence/pilot/provenance.json",
      "reusedLicense": "../K-evidence/pilot/LICENSE",
      "sourceSha256": "8049944060cfc7e8a3a95cc65f5e097ebb07469c5e8b871b678f151312e88e46",
      "tokenSha256": "fea39bd5afdc618703449f1b296b20acbd36984c9d586ed9e6fbb6180ba4a109",
      "sourceImports": [],
      "contracts": [
        "modifies arr",
        "ensures result === arr",
        "ensures arr.every((v, k) => Object.is(v, old(arr.slice())[arr.length - 1 - k]))"
      ],
      "annotations": [
        "invariant Number.isInteger(i) && 0 <= i && i <= arr.length",
        "invariant Number.isInteger(j) && -1 <= j && j < arr.length && j === arr.length - 1 - i",
        "invariant arr.every((v, k) => k < i || k > j ? Object.is(v, old(arr.slice())[arr.length - 1 - k]) : Object.is(v, old(arr.slice())[k]))",
        "decreases real(arr.length) - real(i)"
      ],
      "rankAdaptation": {
        "before": "decreases real(arr.length) - real(i)",
        "after": "decreases real(arr.length - 0) - real(i)",
        "authored": true,
        "rationale": "The inspected rank obligation retains FP finiteness tests for raw length. Subtracting zero is exact for every native length and gives the maintained numeric owner an explicit signed-integer expression before embedding it. Same rank, same entry replay measure, no input bound. The unrun real(length - i) and real(length + 0) - real(i) candidates retained FP rank comparisons and were rejected after query inspection."
      },
      "adapter": "../K-evidence/pilot/check.mjs",
      "adapterSha256": "c6d3c782dab72bca05eba40ff1f9dd6e159995df321b0ef68bd068412cc9358f"
    },
