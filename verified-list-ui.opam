opam-version: "2.0"
synopsis: "A browser list UI whose state, transitions, and view are proved in Rocq"
maintainer: "Rick <rickono12@gmail.com>"
depends: [
  "ocaml-base-compiler" {= "5.3.0"}
  "dune" {= "3.23.1"}
  "rocq-core" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "js_of_ocaml" {= "6.5.0"}
  "js_of_ocaml-compiler" {= "6.5.0"}
  "js_of_ocaml-ppx" {= "6.5.0"}
]
build: [["dune" "build" "-p" name "-j" jobs]]
