// A level that should stay below its cap.  The guard is off by one, so
// Rocq cannot prove belowCap after Raised.

export const cap = 10;

model({
  level: local(nat(cap), 0),
});

on("Raised", nat(cap), (n) => {
  if (model.level + n <= cap) {
    next.level = model.level + n;
  }
});

on("Lowered", () => {
  next.level = 0;
});

invariant("belowCap", () => model.level < cap);
